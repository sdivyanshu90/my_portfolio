# All integrations are optional for local development.
# Leave values empty to use deterministic answers and in-memory storage.
# Copy to .env.local only if that file does not already exist.

# Optional model narration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NARRATION_DAILY_CAP=300
NARRATION_HEDGE_MS=4000

# Optional development Neon database; apply schema with npm run db:migrate.
# NeonDB_URI takes precedence over DATABASE_URL if both are configured.
DATABASE_URL=

# Optional shared cache and rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_SALT=

# Optional admin access and email notifications
ADMIN_TOKEN=
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
CRON_SECRET=

# Optional authenticated GitHub sync and claim verification
GITHUB_TOKEN=
