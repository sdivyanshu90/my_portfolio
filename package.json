{
  "name": "portfolio.com",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run sync-github && npm run eval",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vite-node --config vitest.config.mts scripts/eval.ts --",
    "db:migrate": "vite-node --config vitest.config.mts scripts/db-migrate.ts",
    "verify-claims": "vite-node --config vitest.config.mts scripts/verify-claims.ts",
    "sync-github": "vite-node --config vitest.config.mts scripts/sync-github.ts",
    "smoke": "vite-node --config vitest.config.mts scripts/smoke.ts --",
    "cv:pdf": "vite-node --config vitest.config.mts scripts/cv-pdf.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^1.5.0",
    "framer-motion": "^12.5.0",
    "next": "15.2.8",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.27.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.2.3",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "playwright-core": "^1.63.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
